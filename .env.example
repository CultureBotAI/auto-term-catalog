# Credential required by the default CBORG-backed OntoGPT configuration.
# Copy this file to .env and set the value there; never put a secret here.
CBORG_API_KEY=

# Local input paths used by the README commands. These are shell conveniences;
# the pipeline receives them through command-line arguments.
MERGED_KG_NODES=/absolute/path/to/merged-kg_nodes.tsv
MERGED_KG_EDGES=/absolute/path/to/merged-kg_edges.tsv
METPO_OWL=/absolute/path/to/metpo.owl
